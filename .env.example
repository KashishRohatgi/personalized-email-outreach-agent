# Application
APP_NAME=AI Personalized Outreach Agent
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Database
# In production set this to a real database URL. Never store credentials in code.
DATABASE_URL=sqlite:///./agent.db
DATABASE_ECHO=false

# Gemini (leave empty to use the explicit local mock provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
